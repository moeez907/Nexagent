# ==============================================================================
# NexAgent Docker Configuration
#
# 👉 ONLY ONE STEP REQUIRED:
# Paste your Nebius API Key below, then simply run:
#    docker compose up
#
# Everything else (PostgreSQL, Redis, Tables, Playwright, Frontend) will
# automatically start and configure itself inside Docker without any setup!
# ==============================================================================

# Required: Your Nebius AI Token Factory API Key
NEBIUS_API_KEY=your_actual_nebius_api_key_here

# Optional: LLM Model Settings (defaults to Nemotron 3.5 VL)
LLM_PROVIDER=nebius
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL

# Optional: Host Port Overrides (Internal Docker network handles defaults automatically)
# POSTGRES_PORT=5433
# REDIS_PORT=6380

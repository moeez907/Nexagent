# Application Environment
APP_ENV=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# LLM Configuration (Nebius Token Factory)
LLM_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_TIMEOUT_SECONDS=

# Database Configuration (PostgreSQL required)
POSTGRES_URL=postgresql+asyncpg://postgres:123@localhost:5432/web_agent

# Redis Configuration (Ephemeral State & Caching)
REDIS_URL=redis://localhost:6379/0
USE_REDIS_MEMORY_FALLBACK=false
REDIS_CONNECT_TIMEOUT_SECONDS=5

# Browser Execution Settings
BROWSER_HEADLESS=true
BROWSER_PERSISTENT_PROFILE=true
BROWSER_PROFILE_DIR=./data/browser_profile
BROWSER_REQUIRE_LOGIN_BEFORE_TASK=true
BROWSER_ELECTRON_CDP=false
BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_SLOW_MO_MS=100
MAX_TASK_STEPS=30
MAX_ACTION_RETRIES=3
MAX_SAME_STATE_REPETITIONS=3
ACTION_TIMEOUT_MS=15000
PAGE_LOAD_TIMEOUT_MS=30000

# RAG & Knowledge Configuration
RAG_ENABLED=true
PLAYWRIGHT_DOCS_PATH=../playwright/docs

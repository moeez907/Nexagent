{
  "name": "web-agent-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"npm run dev -- --port 5174 --strictPort\" \"wait-on http://localhost:5174 && cross-env AWA_FRONTEND_URL=http://localhost:5174 npm run desktop\"",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "@vitejs/plugin-react": "^4.2.1",
    "wait-on": "^8.0.3",
    "vite": "^5.1.4"
  }
}
